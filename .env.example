# ghurnilipi — environment
#
# Copy to .env.local and fill in.

# ── public: safe in the browser bundle ─────────────────────────────────────
# The anon / publishable key is protected by the row-level security policies in
# supabase/migrations/0001_init.sql, which let the public read the catalogue and
# insert a commission, and nothing else.
#
# Without these the site still runs: the gallery falls back to the committed
# catalogue in src/data/catalog.ts, and the commission form points visitors at
# WhatsApp rather than failing silently.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── server only: never prefixed NEXT_PUBLIC_ ───────────────────────────────
# Used by `npm run assets:upload` to create the Storage buckets and upload the
# media. Bypasses row-level security entirely, so anything NEXT_PUBLIC_ would
# hand every visitor full read/write on the commissions table.
# Dashboard: Settings -> API Keys -> secret / service_role.
#
# Only needed when publishing assets. The running site does not use it.

SUPABASE_SECRET_KEY=
