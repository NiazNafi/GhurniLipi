# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env
.env.local
.env*.local

# Generated media. The bytes live in Supabase Storage (see npm run assets:upload);
# these are just the local build workspace, rebuildable with `npm run assets`.
/public/artwork/
/public/photo/
/public/media/
/public/brand/
/public/icon.png

# ...but the example file documents what is needed and must be committed.
!.env.example
